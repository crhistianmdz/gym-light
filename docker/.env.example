# GymFlow Lite - Environment Variables
# Copy this file to docker/.env and customize the values
# cp docker/.env.example docker/.env

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
POSTGRES_DB=gymflow_dev
POSTGRES_USER=gymflow
# IMPORTANT: Change this to a strong password in production!
# Use: openssl rand -base64 32
POSTGRES_PASSWORD=changeme

# =============================================================================
# REDIS
# =============================================================================
REDIS_CONNECTION=redis:6379

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# IMPORTANT: Change this to a strong secret in production!
# Use: openssl rand -base64 32 | tr -d '\n'
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_ISSUER=gymflow-api
JWT_AUDIENCE=gymflow-client

# =============================================================================
# APPLICATION
# =============================================================================
# Options: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Development

# =============================================================================
# PORTS (optional overrides)
# =============================================================================
# Uncomment and modify if ports 3000 or 5000 are in use
# BACKEND_PORT=5000
# FRONTEND_PORT=3000
# POSTGRES_PORT=5432
# REDIS_PORT=6379