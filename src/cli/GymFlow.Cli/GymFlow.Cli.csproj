<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GymFlow.Cli</RootNamespace>
    <AssemblyName>gymflow</AssemblyName>
    <Version>1.0.0</Version>
    <Description>CLI for GymFlow Lite - Self-hosted gym management</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="YamlDotNet" Version="15.1.0" />
  </ItemGroup>

  <!-- Note: CLI is self-contained for Phase 1. 
       Backend services will be consumed via HTTP API or shared libraries in later phases. -->
  <!-- 
  <ItemGroup>
    <ProjectReference Include="..\..\backend\Application\Application.csproj" />
  </ItemGroup> 
  -->
</Project>